# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ClaroTasksApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'ClaroTasksAppTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # React Native 0.76's generated codegen phase splits paths containing spaces.
    react_codegen_target = installer.pods_project.targets.find { |target| target.name == 'ReactCodegen' }
    raise 'ReactCodegen target was not generated' unless react_codegen_target

    codegen_phase = react_codegen_target.shell_script_build_phases.find { |phase| phase.name.include?('Generate Specs') }
    raise 'ReactCodegen Generate Specs phase was not generated' unless codegen_phase
    raise 'Unexpected ReactCodegen script format' unless codegen_phase.shell_script.include?('/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT"')

    codegen_phase.shell_script = codegen_phase.shell_script.sub(
      '/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT"',
      ". \"$WITH_ENVIRONMENT\"\n\"$SCRIPT_PHASES_SCRIPT\""
    )
  end
end
